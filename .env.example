# ==========================================================
# Variables de entorno - digitalfix-ms-catalog (Plantilla)
# ==========================================================
# --- Base de datos Oracle Autonomous (con wallet) ---
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<alias>_high?TNS_ADMIN=./wallet
SPRING_DATASOURCE_USERNAME=<usuario_bd>
SPRING_DATASOURCE_PASSWORD=<contrasena_bd>

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Puerto local ---
SERVER_PORT=8084
PORT=8084

# Microsoft Entra ID: misma App Registration y tenant que ms-login y ms-user
AZURE_TENANT_ID=3fb8463e-0e33-4b7d-adc1-2a47c707831e
AZURE_CLIENT_ID=9494b59c-9c6e-4a0f-91ae-ae90212882e7

# ms-user: fuente del rol de negocio del usuario (autorizacion por rol)
MS_USER_URL=http://localhost:8082
